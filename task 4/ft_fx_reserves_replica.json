{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Replica of FT chart: US dollar vs renminbi share of allocated FX reserves (dual axis). Data traced manually from the FT chart; source IMF COFER.",
  "width": 460,
  "height": 260,
  "background": "#FFF1E5",
  "padding": {
    "left": 15,
    "right": 15,
    "top": 15,
    "bottom": 15
  },
  "title": {
    "text": [
      "The dollar is dominant in FX reserves but its lead is",
      "starting to slip"
    ],
    "subtitle": "Currency share of allocated foreign currency reserves (%)",
    "anchor": "start",
    "fontSize": 22,
    "fontWeight": 400,
    "color": "#33302E",
    "subtitleFontSize": 16,
    "subtitleColor": "#66605C",
    "subtitlePadding": 18,
    "offset": 12
  },
  "data": {
    "url": "https://raw.githubusercontent.com/cahyani-dewi/cahyani-dewi.github.io/refs/heads/main/task%204/fx_reserves.csv",
    "format": {
      "type": "csv",
      "parse": {
        "date": "date",
        "usd": "number",
        "rmb": "number"
      }
    }
  },
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "title": null,
      "scale": {
        "domain": [
          {
            "year": 2000,
            "month": 1,
            "date": 1
          },
          {
            "year": 2024,
            "month": 1,
            "date": 1
          }
        ]
      },
      "axis": {
        "values": [
          {
            "year": 2000,
            "month": 1,
            "date": 1
          },
          {
            "year": 2004,
            "month": 1,
            "date": 1
          },
          {
            "year": 2008,
            "month": 1,
            "date": 1
          },
          {
            "year": 2012,
            "month": 1,
            "date": 1
          },
          {
            "year": 2016,
            "month": 1,
            "date": 1
          },
          {
            "year": 2020,
            "month": 1,
            "date": 1
          },
          {
            "year": 2024,
            "month": 1,
            "date": 1
          }
        ],
        "labelExpr": "'Q1 ' + timeFormat(datum.value, '%Y')",
        "grid": false,
        "domain": true,
        "ticks": true,
        "domainColor": "#66605C",
        "tickColor": "#66605C",
        "tickSize": 5,
        "labelOverlap": false,
        "labelFlush": false,
        "labelFontSize": 14,
        "labelColor": "#33302E",
        "labelPadding": 4
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3.5,
        "interpolate": "linear"
      },
      "encoding": {
        "y": {
          "field": "usd",
          "type": "quantitative",
          "title": null,
          "scale": {
            "domain": [
              45,
              75
            ],
            "zero": false,
            "nice": false
          },
          "axis": {
            "orient": "left",
            "values": [
              45,
              50,
              55,
              60,
              65,
              70,
              75
            ],
            "grid": true
          }
        },
        "color": {
          "datum": "US dollars",
          "type": "nominal",
          "scale": {
            "domain": [
              "US dollars",
              "Renminbi (right scale)"
            ],
            "range": [
              "#9DCAE6",
              "#1F4A86"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "title": null,
            "symbolType": "square",
            "symbolSize": 200,
            "labelFontSize": 16,
            "labelColor": "#33302E",
            "columnPadding": 14,
            "offset": 16,
            "encode": {
              "symbols": {
                "update": {
                  "fill": {
                    "scale": "color",
                    "field": "value"
                  },
                  "fillOpacity": {
                    "value": 1
                  },
                  "stroke": {
                    "value": "transparent"
                  },
                  "strokeWidth": {
                    "value": 0
                  }
                }
              }
            },
            "labelLimit": 0
          }
        }
      }
    },
    {
      "transform": [
        {
          "filter": "isValid(datum.rmb)"
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 3.5,
        "interpolate": "linear"
      },
      "encoding": {
        "y": {
          "field": "rmb",
          "type": "quantitative",
          "title": null,
          "scale": {
            "domain": [
              1,
              7
            ],
            "zero": false,
            "nice": false
          },
          "axis": {
            "orient": "right",
            "values": [
              1,
              2,
              3,
              4,
              5,
              6,
              7
            ],
            "grid": false
          }
        },
        "color": {
          "datum": "Renminbi (right scale)",
          "type": "nominal",
          "scale": {
            "domain": [
              "US dollars",
              "Renminbi (right scale)"
            ],
            "range": [
              "#9DCAE6",
              "#1F4A86"
            ]
          }
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "t": "Source: IMF"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "top",
        "fontSize": 14,
        "color": "#33302E"
      },
      "encoding": {
        "x": {
          "value": 490
        },
        "y": {
          "value": 308
        },
        "text": {
          "field": "t"
        }
      }
    }
  ],
  "resolve": {
    "scale": {
      "y": "independent"
    }
  },
  "config": {
    "font": "Work Sans, Metric, Helvetica, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 16,
      "labelColor": "#66605C",
      "labelPadding": 6,
      "domain": false,
      "ticks": false,
      "gridColor": "#D9CCC1",
      "gridWidth": 1
    }
  }
}
