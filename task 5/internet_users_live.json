{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 470,
  "height": 320,
  "padding": {
    "right": 150
  },
  "title": {
    "text": "Fewer than 1 in 4 people in low-income countries use the internet",
    "subtitle": [
      "Individuals using the internet, % of population, by World Bank income group",
      "Source: ITU, live from the World Bank Data360 API (WB_WDI_IT_NET_USER_ZS)"
    ]
  },
  "data": {
    "url": "https://data360api.worldbank.org/data360/data?DATABASE_ID=WB_WDI&INDICATOR=WB_WDI_IT_NET_USER_ZS&REF_AREA=LIC,LMC,UMC,HIC",
    "format": {
      "type": "json",
      "property": "value"
    }
  },
  "transform": [
    {
      "filter": "datum.OBS_VALUE != null"
    },
    {
      "calculate": "{'LIC':'Low income','LMC':'Lower middle income','UMC':'Upper middle income','HIC':'High income'}[datum.REF_AREA]",
      "as": "Group"
    },
    {
      "calculate": "toNumber(datum.TIME_PERIOD)",
      "as": "Year"
    },
    {
      "calculate": "round(toNumber(datum.OBS_VALUE)*10)/10",
      "as": "Share"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "Year",
          "as": "LastYear"
        }
      ]
    }
  ],
  "encoding": {
    "x": {
      "field": "Year",
      "type": "quantitative",
      "scale": {
        "nice": false,
        "zero": false
      },
      "axis": {
        "format": "d",
        "title": null,
        "grid": false,
        "tickCount": 6
      }
    },
    "y": {
      "field": "Share",
      "type": "quantitative",
      "title": null,
      "scale": {
        "domain": [
          0,
          100
        ]
      },
      "axis": {
        "values": [
          0,
          20,
          40,
          60,
          80,
          100
        ],
        "labelExpr": "datum.value + '%'",
        "domain": false,
        "ticks": false
      }
    },
    "color": {
      "field": "Group",
      "type": "nominal",
      "legend": null,
      "scale": {
        "domain": [
          "Low income",
          "Lower middle income",
          "Upper middle income",
          "High income"
        ],
        "range": [
          "#08306b",
          "#2171b5",
          "#6baed6",
          "#9ecae1"
        ]
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.5,
        "strokeCap": "round"
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Year === datum.LastYear"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 45,
        "opacity": 1
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Year === datum.LastYear"
        },
        {
          "calculate": "datum.Group + '  ' + format(datum.Share, '.0f') + '%'",
          "as": "Label"
        },
        {
          "calculate": "datum.Group === 'High income' ? datum.Share + 2.5 : datum.Group === 'Upper middle income' ? datum.Share - 2.5 : datum.Share",
          "as": "LabelY"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "fontSize": 11.5,
        "fontWeight": 500
      },
      "encoding": {
        "text": {
          "field": "Label"
        },
        "y": {
          "field": "LabelY",
          "type": "quantitative"
        }
      }
    },
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "encodings": [
              "x"
            ],
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#999"
      },
      "encoding": {
        "opacity": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": 0.6
          },
          "value": 0
        },
        "tooltip": [
          {
            "field": "Year",
            "format": "d"
          },
          {
            "field": "Group"
          },
          {
            "field": "Share",
            "title": "% of population"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Inter, system-ui, sans-serif",
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 11,
      "labelColor": "#666",
      "titleColor": "#666",
      "domainColor": "#bbb",
      "tickColor": "#bbb",
      "gridColor": "#eee"
    },
    "title": {
      "fontSize": 16,
      "subtitleFontSize": 12,
      "subtitleColor": "#666",
      "anchor": "start",
      "offset": 12
    }
  }
}
