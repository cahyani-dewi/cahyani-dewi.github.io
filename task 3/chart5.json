{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Vietnam's economy more than tripled",
    "subtitle": [
      "GDP per capita (PPP, constant 2021 international $), 2000–2024",
      "Source: Our World in Data (World Bank)"
    ],
    "anchor": "start",
    "fontSize": 16,
    "subtitleColor": "#52514e"
  },
  "config": {
    "background": "#ffffff",
    "font": "Helvetica, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#52514e",
      "titleColor": "#52514e",
      "gridColor": "#ecebe7",
      "domainColor": "#c3c2b7",
      "tickColor": "#c3c2b7",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": "normal"
    }
  },
  "data": {
    "url": "https://raw.githubusercontent.com/cahyani-dewi/cahyani-dewi.github.io/refs/heads/main/task%203/vietnamgdp.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "gdp_per_capita_ppp": "number"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.5,
        "color": "#2a78d6"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "title": null,
          "scale": {
            "domain": [
              2000,
              2024
            ]
          },
          "axis": {
            "format": "d",
            "tickCount": 6,
            "grid": false
          }
        },
        "y": {
          "field": "gdp_per_capita_ppp",
          "type": "quantitative",
          "title": null,
          "axis": {
            "format": "$,.0f",
            "tickCount": 4,
            "grid": true,
            "domain": false,
            "ticks": false
          }
        }
      }
    },
    {
      "transform": [
        {
          "window": [
            {
              "op": "row_number",
              "as": "rev"
            }
          ],
          "sort": [
            {
              "field": "year",
              "order": "descending"
            }
          ]
        },
        {
          "filter": "datum.rev === 1"
        },
        {
          "calculate": "format(datum.gdp_per_capita_ppp, '$,.0f')",
          "as": "latest_label"
        }
      ],
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative"
        },
        "y": {
          "field": "gdp_per_capita_ppp",
          "type": "quantitative"
        }
      },
      "layer": [
        {
          "mark": {
            "type": "point",
            "filled": true,
            "size": 70,
            "color": "#2a78d6",
            "stroke": "#ffffff",
            "strokeWidth": 2,
            "opacity": 1
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "right",
            "dx": -8,
            "dy": -10,
            "fontSize": 12,
            "fontWeight": "bold",
            "color": "#000000"
          },
          "encoding": {
            "text": {
              "field": "latest_label"
            }
          }
        }
      ]
    },
    {
      "params": [
        {
          "name": "hover1",
          "select": {
            "type": "point",
            "on": "pointerover",
            "nearest": true,
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "point",
        "size": 80,
        "filled": true,
        "color": "#2a78d6"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative"
        },
        "y": {
          "field": "gdp_per_capita_ppp",
          "type": "quantitative"
        },
        "opacity": {
          "condition": {
            "param": "hover1",
            "empty": false,
            "value": 1
          },
          "value": 0
        },
        "tooltip": [
          {
            "field": "year",
            "type": "quantitative",
            "title": "Year"
          },
          {
            "field": "gdp_per_capita_ppp",
            "type": "quantitative",
            "title": "GDP per capita",
            "format": "$,.0f"
          }
        ]
      }
    }
  ],
  "width": "container",
  "height": 340,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "view": {
    "fill": "#ffffff",
    "stroke": null
  }
}
