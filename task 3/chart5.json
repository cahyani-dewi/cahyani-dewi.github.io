{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Vietnam's economy more than tripled",
    "subtitle": [
      "GDP per capita (PPP, constant 2021 international $), 2000–2024",
      "Source: Our World in Data (World Bank)"
    ],
    "anchor": "start",
    "fontSize": 16,
    "subtitleColor": "#52514e"
  },
  "config": {
    "background": "#fcfcfb",
    "font": "Helvetica, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#52514e",
      "titleColor": "#52514e",
      "gridColor": "#e8e7e3",
      "domainColor": "#c3c2b7",
      "tickColor": "#c3c2b7",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": "normal"
    }
  },
  "width": 560,
  "height": 200,
  "data": {
    "url": "https://raw.githubusercontent.com/cahyani-dewi/cahyani-dewi.github.io/refs/heads/main/task%203/vietnamgdp.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "gdp_per_capita_ppp": "number"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2,
        "color": "#13d1c4"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "title": null,
          "scale": {
            "domain": [
              2000,
              2024
            ]
          },
          "axis": {
            "format": "d",
            "tickCount": 6
          }
        },
        "y": {
          "field": "gdp_per_capita_ppp",
          "type": "quantitative",
          "title": null,
          "axis": {
            "format": "$,.0f",
            "tickCount": 4
          }
        }
      }
    },
    {
      "params": [
        {
          "name": "hover1",
          "select": {
            "type": "point",
            "on": "pointerover",
            "nearest": true,
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "point",
        "size": 80,
        "filled": true,
        "color": "#a9b5b1"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative"
        },
        "y": {
          "field": "gdp_per_capita_ppp",
          "type": "quantitative"
        },
        "opacity": {
          "condition": {
            "param": "hover1",
            "empty": false,
            "value": 1
          },
          "value": 0
        },
        "tooltip": [
          {
            "field": "year",
            "type": "quantitative",
            "title": "Year"
          },
          {
            "field": "gdp_per_capita_ppp",
            "type": "quantitative",
            "title": "GDP per capita",
            "format": "$,.0f"
          }
        ]
      }
    }
  ]
}
