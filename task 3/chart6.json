{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Vietnam's air didn't get cleaner",
    "subtitle": [
      "Air pollution: population-weighted PM2.5 (µg/m³), 2000–2024",
      "Source: Our World in Data"
    ],
    "anchor": "start",
    "fontSize": 16,
    "subtitleColor": "#52514e"
  },
  "config": {
    "background": "#fcfcfb",
    "font": "Helvetica, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#52514e",
      "titleColor": "#52514e",
      "gridColor": "#e8e7e3",
      "domainColor": "#c3c2b7",
      "tickColor": "#c3c2b7",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": "normal"
    }
  },
  "width": 560,
  "height": 200,
  "data": {
    "url": "https://ourworldindata.org/grapher/outdoor-air-pollution-exposure.csv?v=1&csvType=full&useColumnShortNames=true",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "population_weighted_pm25": "number"
      }
    }
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "title": null,
      "scale": {
        "domain": [
          2000,
          2024
        ]
      },
      "axis": {
        "format": "d",
        "tickCount": 6
      }
    },
    "y": {
      "field": "pm25",
      "type": "quantitative",
      "title": null,
      "scale": {
        "domain": [
          0,
          30
        ]
      },
      "axis": {
        "tickCount": 4
      }
    }
  },
  "layer": [
    {
      "data": {
        "values": [
          {
            "who": 5
          }
        ]
      },
      "mark": {
        "type": "rule",
        "strokeDash": [
          4,
          4
        ],
        "color": "#8a8983",
        "strokeWidth": 1
      },
      "encoding": {
        "y": {
          "field": "who",
          "type": "quantitative"
        },
        "x": {
          "value": 0
        },
        "x2": {
          "value": 560
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "who": 5,
            "label": "WHO guideline: 5 µg/m³"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 4,
        "dy": -7,
        "fontSize": 11,
        "color": "#52514e"
      },
      "encoding": {
        "y": {
          "field": "who",
          "type": "quantitative"
        },
        "x": {
          "value": 0
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2
      },
      "encoding": {
        "detail": {
          "field": "entity"
        },
        "color": {
          "field": "entity",
          "scale": {
            "domain": [
              "Vietnam",
              "Thailand",
              "Philippines"
            ],
            "range": [
              "#2a78d6",
              "#eb6834",
              "#1baf7a"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "symbolType": "stroke",
            "symbolStrokeWidth": 2,
            "labelColor": "#52514e",
            "labelFontSize": 11,
            "offset": 4
          },
          "title": null
        }
      }
    },
    {
      "transform": [
        {
          "joinaggregate": [
            {
              "op": "max",
              "field": "year",
              "as": "last"
            }
          ],
          "groupby": [
            "entity"
          ]
        },
        {
          "filter": "datum.year === datum.last"
        },
        {
          "calculate": "datum.pm25 + (datum.entity === 'Thailand' ? 1 : datum.entity === 'Philippines' ? -1 : 0)",
          "as": "labelY"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "fontSize": 11
      },
      "encoding": {
        "text": {
          "field": "entity"
        },
        "color": {
          "value": "#0b0b0b"
        },
        "y": {
          "field": "labelY",
          "type": "quantitative"
        }
      }
    },
    {
      "params": [
        {
          "name": "hover2",
          "select": {
            "type": "point",
            "on": "pointerover",
            "nearest": true,
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "point",
        "size": 80,
        "filled": true
      },
      "encoding": {
        "color": {
          "field": "entity",
          "legend": null
        },
        "opacity": {
          "condition": {
            "param": "hover2",
            "empty": false,
            "value": 1
          },
          "value": 0
        },
        "tooltip": [
          {
            "field": "entity",
            "title": "Country"
          },
          {
            "field": "year",
            "type": "quantitative",
            "title": "Year"
          },
          {
            "field": "pm25",
            "type": "quantitative",
            "title": "PM2.5 (µg/m³)",
            "format": ".1f"
          }
        ]
      }
    }
  ],
  "transform": [
    {
      "filter": "indexof(['VNM','THA','PHL'], datum.code) >= 0 && datum.year >= 2000 && datum.year <= 2024"
    },
    {
      "calculate": "datum.population_weighted_pm25",
      "as": "pm25"
    }
  ]
}
