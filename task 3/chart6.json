{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Vietnam's air didn't get cleaner",
    "subtitle": [
      "Air pollution: population-weighted PM2.5 (µg/m³), 2000–2024",
      "Source: Our World in Data"
    ],
    "anchor": "start",
    "fontSize": 16,
    "subtitleColor": "#52514e"
  },
  "config": {
    "background": "#ffffff",
    "font": "Helvetica, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#52514e",
      "titleColor": "#52514e",
      "gridColor": "#ecebe7",
      "domainColor": "#c3c2b7",
      "tickColor": "#c3c2b7",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": "normal"
    }
  },
  "data": {
    "url": "https://ourworldindata.org/grapher/outdoor-air-pollution-exposure.csv?v=1&csvType=full&useColumnShortNames=true",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "population_weighted_pm25": "number"
      }
    }
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "title": null,
      "scale": {
        "domain": [
          2000,
          2024
        ]
      },
      "axis": {
        "format": "d",
        "tickCount": 6,
        "grid": false
      }
    },
    "y": {
      "field": "pm25",
      "type": "quantitative",
      "title": null,
      "scale": {
        "domain": [
          0,
          30
        ]
      },
      "axis": {
        "tickCount": 4,
        "grid": true,
        "domain": false,
        "ticks": false
      }
    }
  },
  "layer": [
    {
      "data": {
        "values": [
          {
            "who": 5
          }
        ]
      },
      "mark": {
        "type": "rule",
        "strokeDash": [
          4,
          4
        ],
        "color": "#8a8983",
        "strokeWidth": 1
      },
      "encoding": {
        "y": {
          "field": "who",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "who": 5,
            "label": "WHO guideline: 5 µg/m³"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 4,
        "dy": -7,
        "fontSize": 11,
        "color": "#52514e"
      },
      "encoding": {
        "y": {
          "field": "who",
          "type": "quantitative"
        },
        "x": {
          "value": 0
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.entity !== 'Vietnam'"
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 1.5
      },
      "encoding": {
        "detail": {
          "field": "entity"
        },
        "color": {
          "field": "entity",
          "scale": {
            "domain": [
              "Thailand",
              "Philippines"
            ],
            "range": [
              "#8f8e88",
              "#b5b4ae"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.entity === 'Vietnam'"
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 2.75,
        "color": "#2a78d6"
      }
    },
    {
      "data": {
        "values": [
          {
            "year": 2007,
            "y": 29.6,
            "label": "Levels off from 2007"
          }
        ]
      },
      "layer": [
        {
          "mark": {
            "type": "rule",
            "color": "#8a8983",
            "strokeWidth": 1,
            "strokeDash": [
              2,
              2
            ]
          },
          "encoding": {
            "x": {
              "field": "year",
              "type": "quantitative"
            },
            "y": {
              "datum": 27.5
            },
            "y2": {
              "datum": 29.6
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 4,
            "baseline": "middle",
            "fontSize": 10,
            "color": "#52514e"
          },
          "encoding": {
            "x": {
              "field": "year",
              "type": "quantitative"
            },
            "y": {
              "field": "y",
              "type": "quantitative"
            },
            "text": {
              "field": "label"
            }
          }
        }
      ]
    },
    {
      "transform": [
        {
          "joinaggregate": [
            {
              "op": "max",
              "field": "year",
              "as": "last"
            }
          ],
          "groupby": [
            "entity"
          ]
        },
        {
          "filter": "datum.year === datum.last"
        },
        {
          "calculate": "datum.pm25 + (datum.entity === 'Vietnam' ? 0.8 : datum.entity === 'Thailand' ? 0.6 : -1.0)",
          "as": "labelY"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "fontSize": 11
      },
      "encoding": {
        "text": {
          "field": "entity"
        },
        "color": {
          "condition": {
            "test": "datum.entity === 'Vietnam'",
            "value": "#000000"
          },
          "value": "#6b6a65"
        },
        "y": {
          "field": "labelY",
          "type": "quantitative"
        }
      }
    },
    {
      "params": [
        {
          "name": "hover2",
          "select": {
            "type": "point",
            "on": "pointerover",
            "nearest": true,
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "point",
        "size": 80,
        "filled": true
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "datum.entity === 'Vietnam'",
            "value": "#2a78d6"
          },
          "value": "#8f8e88"
        },
        "opacity": {
          "condition": {
            "param": "hover2",
            "empty": false,
            "value": 1
          },
          "value": 0
        },
        "tooltip": [
          {
            "field": "entity",
            "title": "Country"
          },
          {
            "field": "year",
            "type": "quantitative",
            "title": "Year"
          },
          {
            "field": "pm25",
            "type": "quantitative",
            "title": "PM2.5 (µg/m³)",
            "format": ".1f"
          }
        ]
      }
    }
  ],
  "transform": [
    {
      "filter": "indexof(['VNM','THA','PHL'], datum.code) >= 0 && datum.year >= 2000 && datum.year <= 2024"
    },
    {
      "calculate": "datum.population_weighted_pm25",
      "as": "pm25"
    }
  ],
  "width": "container",
  "height": 340,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "view": {
    "fill": "#ffffff",
    "stroke": null
  }
}
